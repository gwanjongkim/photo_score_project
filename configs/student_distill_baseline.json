{
  "experiment_name": "stage5_student_aadb_baseline",
  "manifest_csv": "data/distill/stage5_aadb_teacher_labels.csv",
  "output_dir": "checkpoints/stage5_student_aadb_baseline",
  "seed": 42,
  "data": {
    "train_splits": ["train"],
    "val_splits": ["val"],
    "test_splits": ["test"],
    "image_size": 224,
    "batch_size": 64,
    "shuffle_buffer": 4096,
    "augment_horizontal_flip": false,
    "cache": false
  },
  "model": {
    "alpha": 0.5,
    "head_units": 128,
    "dropout_rate": 0.2,
    "backbone_trainable": true,
    "backbone_weights": "imagenet"
  },
  "train": {
    "epochs": 20,
    "learning_rate": 0.0001,
    "weight_decay": 0.00001,
    "loss": "huber",
    "huber_delta": 0.05,
    "use_ranking_loss": false,
    "ranking_weight": 0.0,
    "ranking_margin": 0.03,
    "early_stopping_patience": 5,
    "reduce_lr_patience": 2,
    "min_learning_rate": 0.000001,
    "checkpoint_monitor": "val_spearman",
    "checkpoint_monitor_mode": "max"
  },
  "eval": {
    "pairwise_margin": 0.03,
    "pairwise_max_pairs": 50000,
    "top_k": 10
  }
}
